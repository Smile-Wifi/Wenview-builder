# ====================================================================
# HTML to APK Builder - Environment Configuration
# ====================================================================

# Port for local dev server (AI Studio requires port 3000)
PORT=3000

# Base public application URL (for webhooks, downloads, and callbacks)
APP_URL="http://localhost:3000"

# --- Android Release Signing Secrets ---
# Base64 encoded Java Keystore (.jks or .keystore) for production APK release signing
KEYSTORE_BASE64=""
# Keystore password
KEYSTORE_PASS="android"
# Key alias name in the keystore
KEY_ALIAS="key0"
# Key password (optional, defaults to KEYSTORE_PASS)
KEY_PASS="android"

# --- GitHub Actions Remote Build Worker (Optional / Production) ---
# GitHub Personal Access Token (classic or fine-grained with actions:write & repo scope)
GH_TOKEN=""
# Target GitHub repository where build-apk.yml workflow is located (owner/repo)
GITHUB_REPO=""
# Workflow file name (default: build-apk.yml)
GITHUB_WORKFLOW="build-apk.yml"

# --- Webhook Callback & Redis/KV Storage (Optional) ---
# Callback URL for remote build worker notification
CALLBACK_URL="http://localhost:3000/api/callback"
# Redis or KV URL for distributed build status caching
KV_URL=""
